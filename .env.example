# Application environment: development, test, or production.
ENVIRONMENT=development

# Production must use postgresql. Development may use sqlite when DATABASE_URL
# is absent, but explicitly selecting postgresql is recommended for parity.
DB_BACKEND=postgresql

# Server-only. Never copy this value into Frontend or a NEXT_PUBLIC_* variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional bounded pool tuning.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10

# Comma-separated browser origins allowed by FastAPI.
ALLOWED_ORIGINS=http://localhost:3000

# Used only by guarded PostgreSQL integration tests. The tests create and drop
# their own isolated schema inside this database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require

# Optional SQLite development fallback location.
# SQLITE_DATABASE_PATH=./soc_incidents.db

# ─── Ask SENTRA (prototype_ai_chat) ──────────────────────────────────────────
# The chatbot answers from the incident store. Without a key it still answers,
# deterministically, from the retrieved records — the key only enables the
# generation step. Requires DB_BACKEND=postgresql and google-genai
# (pip install -r prototype_ai_chat/requirements.txt).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where the console proxies chat requests. Run the service with:
#   uvicorn prototype_ai_chat.api:app --port 8100
AI_API_URL=http://127.0.0.1:8100
